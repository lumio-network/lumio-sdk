{
  "name": "@lumio/ui",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "Lumio design-system React components and Tailwind preset (\"Ledger of Light\").",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./tailwind-preset": {
      "types": "./dist/tailwind.preset.d.ts",
      "default": "./dist/tailwind.preset.js"
    },
    "./tokens/design-tokens.css": "./src/tokens/design-tokens.css",
    "./tokens/design-tokens.json": "./src/tokens/design-tokens.json"
  },
  "files": ["dist", "src/tokens"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
