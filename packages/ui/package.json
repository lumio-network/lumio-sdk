{
  "name": "@lumio/ui",
  "version": "0.1.0",
  "license": "Apache-2.0",
  "description": "Lumio design-system React components and Tailwind preset (\"Ledger of Light\").",
  "keywords": [
    "lumio",
    "design-system",
    "react",
    "tailwind",
    "components",
    "design-tokens"
  ],
  "author": "Lumio Network",
  "homepage": "https://github.com/lumio-network/lumio-sdk/tree/main/packages/ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lumio-network/lumio-sdk.git",
    "directory": "packages/ui"
  },
  "bugs": {
    "url": "https://github.com/lumio-network/lumio-sdk/issues"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./tailwind-preset": {
      "import": {
        "types": "./dist/esm/tailwind.preset.d.ts",
        "default": "./dist/esm/tailwind.preset.js"
      },
      "require": {
        "types": "./dist/cjs/tailwind.preset.d.ts",
        "default": "./dist/cjs/tailwind.preset.js"
      }
    },
    "./tokens/design-tokens.css": "./src/tokens/design-tokens.css",
    "./tokens/design-tokens.json": "./src/tokens/design-tokens.json"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "src/tokens",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.esm.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.0.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwindcss": "^3.4.14",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
